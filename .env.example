# Copy to .env (gitignored). In Cloud Run these come from Secret Manager.
GEMINI_API_KEY=
SUPERVISOR_MODEL=gemini-3.8-flash
WORKER_MODEL=gemini-3.1-flash-lite
CRITIC_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# replay (recorded fixtures, no cluster needed) | live (kubeconfig / in-cluster)
CLUSTER_MODE=replay
KUBE_CONTEXT=

SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
APP_DB_URL=sqlite:///./data/triage.db

# Write endpoints require X-API-Key; approvals require X-Approver-Token.
TRIAGE_API_KEY=change-me
APPROVER_TOKEN=change-me-too

# none | console | otlp | gcp
TRACE_EXPORTER=console
OTLP_ENDPOINT=http://localhost:4318
GCP_PROJECT=
ENABLE_CLOUD_MONITORING=false

MAX_CRITIC_ROUNDS=2
MAX_TOOL_CALLS_PER_AGENT=8
MAX_LLM_CALLS=60
